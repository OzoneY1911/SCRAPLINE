component PlayerInventory
{
    SlotIndex SelectedSlotIndex;
    array<entity_ref>[3] Slots;
}

signal OnValuableCollectAttempted(entity_ref playerEntity, entity_ref valuableEntity);
signal OnValuableCollected(entity_ref playerEntity);
signal OnInZoneValuableCollectedByPlayer(entity_ref valuableEntity);

event InventorySlotSelected
{
    entity_ref Entity;
    SlotIndex SlotIndex;
}

event ValuableCollected
{
    entity_ref PlayerEntity;
    entity_ref ValuableEntity;
    SlotIndex SlotIndex;
}

event ValuableDropped
{
    entity_ref PlayerEntity;
    entity_ref ValuableEntity;
    SlotIndex SlotIndex;
}