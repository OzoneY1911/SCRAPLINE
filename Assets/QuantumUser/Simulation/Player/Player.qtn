component Player
{
    SByte Strength;

    FP InteractionDistance;

    LayerMask LocalMask;

    [HideInInspector]
    player_ref PlayerRef;

    [HideInInspector]
    FP LookYaw;

    [HideInInspector]
    FP LookPitch;

    [HideInInspector]
    asset_ref<EmoteConfig> CurrentEmoteConfig;
}

event PlayerSpawned { }

event PlayerEmoteChanged
{
    entity_ref PlayerEntity;
    asset_ref<EmoteConfig> EmoteConfig;
}