component Valuable
{
    asset_ref<ValuableConfig> Config;

    Boolean IsShopValuable;

    [HideInInspector]
    FP CurrentValue;
    [HideInInspector]
    FP CurrentFragility;

    list<ResourceFraction> ResourceFractions;

    [HideInInspector]
    EntityRef TrackedZoneEntity;
}

signal OnShopValuableDestroyed(entity_ref valuableEntity);

event ValuableHit
{
    entity_ref Entity;
    FPVector3 Position;
    FP HitDamage;
}