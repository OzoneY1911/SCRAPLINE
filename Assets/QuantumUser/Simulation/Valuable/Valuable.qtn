component Valuable
{
    asset_ref<ValuableConfig> Config;
    Boolean IsPocketValuable;
    list<ResourceFraction> ResourceFractions;

    FP CurrentValue;
    FP Fragility;

    Boolean IsShopValuable;

    [HideInInspector]
    EntityRef QuotaZoneEntity;
}

event ValuableHit
{
    entity_ref Entity;
    FPVector3 Position;
    FP HitDamage;
}